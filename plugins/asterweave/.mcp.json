{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${user_config.github_token}",
        "X-MCP-Toolsets": "default,actions,code_security,secret_protection"
      }
    },
    "azuredevops": {
      "type": "stdio",
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/ado-mcp.mjs", "${user_config.ado_organization}"],
      "env": {
        "PERSONAL_ACCESS_TOKEN": "${user_config.ado_pat_base64}"
      }
    }
  }
}
