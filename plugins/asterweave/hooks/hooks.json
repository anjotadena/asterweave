{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking destructive-operation policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook-stop-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Asterweave evidence gates"
          }
        ]
      }
    ]
  }
}
