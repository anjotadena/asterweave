{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://at-digital-labs.dev/asterweave/scaffold-blueprint.schema.json",
  "title": "Asterweave repository scaffold blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginVersion", "summary", "artifacts"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "pluginVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].*)?$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "operation", "rationale", "evidence", "content"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["instructions", "rule", "skill", "agent", "reference", "adapter"]
          },
          "operation": {
            "enum": ["create", "replace"]
          },
          "expectedSha256": {
            "type": ["string", "null"],
            "pattern": "^[a-f0-9]{64}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128000
          },
          "executable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
