{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://at-digital-labs.dev/asterweave/repository-adapter.schema.json",
  "title": "Asterweave repository adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workItems": {
          "enum": ["github", "azure-devops", "none"]
        }
      }
    },
    "routing": {
      "type": "object",
      "propertyNames": {
        "enum": ["analyze", "challenge", "plan", "implement", "test", "verify", "review", "submit-pr", "monitor-pipeline", "resolve-review-comments", "update-work-item"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredChecks": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        },
        "parallelism": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxWorkers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staleAfterHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "expireAfterHours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "track": {
          "type": "boolean"
        },
        "contextBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warnAtTokens": {
              "type": "integer",
              "minimum": 1000
            }
          }
        }
      }
    },
    "autoContinue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxNudges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "hooks": {
      "type": "array",
      "description": "Executable hooks run by the Asterweave CLI runtime. Loaded only for a trusted repository; a validate hook can only tighten a guard decision.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "event", "argv", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "event": {
            "enum": ["run.started", "node.before-enter", "tool.before", "tool.after", "node.completed", "approval.requested", "run.finished"]
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "kind": {
            "enum": ["validate", "log"]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "onFailure": {
            "enum": ["block", "ignore"]
          }
        },
        "if": {
          "properties": { "kind": { "const": "validate" } },
          "required": ["kind"]
        },
        "then": {
          "properties": { "event": { "enum": ["node.before-enter", "tool.before"] } }
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "source"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7200
              }
            }
          }
        }
      }
    }
  }
}
