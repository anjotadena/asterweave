{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://at-digital-labs.dev/asterweave/repository-adapter.schema.json",
  "title": "Asterweave repository adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "const": 1
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workItems": {
          "enum": ["github", "azure-devops", "none"]
        }
      }
    },
    "routing": {
      "type": "object",
      "propertyNames": {
        "enum": ["analyze", "challenge", "plan", "implement", "test", "verify", "review", "submit-pr", "monitor-pipeline", "resolve-review-comments", "update-work-item"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxWorkers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      }
    },
    "qualityGates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "command", "source"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7200
              }
            }
          }
        }
      }
    }
  }
}
