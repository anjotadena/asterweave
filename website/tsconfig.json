// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true,
    // Set explicitly rather than inherited: if "@docusaurus/tsconfig" fails to resolve (for
    // example before `npm ci`), its noEmit is lost and `npm run typecheck` emits JavaScript
    // beside the sources, which then shadows the .ts/.tsx files and breaks `npm run build`.
    "noEmit": true
  },
  "exclude": [".docusaurus", "build"]
}
